# AWS Configuration
AWS_REGION=<region-id>
AWS_ACCOUNT_ID=<your-account-id>

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5
BEDROCK_KB_ID=<your-knowledge-base-id>

# S3
S3_LOG_BUCKET=<your-log-bucket>
S3_RUNBOOKS_BUCKET=<your-runbooks-bucket>

# GitHub
GITHUB_TOKEN=<your-github-token>
GITHUB_REPO_OWNER=<your-github-org>
GITHUB_REPO_NAME=<your-test-repo>

# Slack
SLACK_WEBHOOK_URL=<your-slack-webhook-url>
SLACK_BOT_TOKEN=<your-slack-bot-token>
SLACK_CHANNEL=<slack-channel>

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=<generate-a-random-secret>

# Pipeline Doctor settings
AUTO_FIX_MAX_STEPS=4
ESCALATE_STEPS_THRESHOLD=5
REQUIRE_APPROVAL_FOR_PRODUCTION=true
ENABLE_AUTO_DEPLOYMENT=true

# AgentCore (if deploying to AgentCore Runtime)
AGENTCORE_RUNTIME_ID=<your-agentcore-runtime-id>
AGENTCORE_ENDPOINT=<your-agentcore-endpoint>
